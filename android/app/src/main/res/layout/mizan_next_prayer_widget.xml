<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_icon_bg">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_my_calendar"
            android:tint="#FFB38964" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/prayer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asr"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/prayer_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="in 45 min"
            android:textColor="#FFB38964"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/prayer_inline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Asr in 45 min"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

</LinearLayout>