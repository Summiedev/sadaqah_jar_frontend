<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/streak_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="4"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="60%"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/streak_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="day streak"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="Week"
            android:textColor="#FFF0D8B8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="13dp"
        android:layout_weight="1"
        android:background="@drawable/widget_panel_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="This week"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/week_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="4/7"
                android:textColor="#FFF0D8B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/day_0"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/widget_day_done_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Sun"
                android:textColor="#FF0A3B34"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_1"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_day_done_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Mon"
                android:textColor="#FF0A3B34"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_2"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_day_done_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Tue"
                android:textColor="#FF0A3B34"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_3"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_day_done_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Wed"
                android:textColor="#FF0A3B34"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_4"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_day_pending_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Thu"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_5"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_day_pending_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Fri"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_6"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_day_pending_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Sat"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/goal_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="18 of 25 acts"
            android:textColor="#FFF0D8B8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_progress_bg"
            android:indeterminate="false"
            android:max="100"
            android:progress="60"
            android:progressTint="#FFF0D8B8"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
